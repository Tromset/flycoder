{
  "name": "flycoder",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "FlyCoder: a local coding model for Ollama, tuned for MacBook and Mac mini",
  "scripts": {
    "test": "node --test tests/bench.test.mjs tests/modelfile.test.mjs tests/fly-language.test.js",
    "bench": "node bench/bench.mjs",
    "language:data": "node scripts/build_language_dataset.js",
    "language:train": ".venv/bin/python training/run.py --detach --serve",
    "language:serve": "HF_HOME=./data/huggingface .venv/bin/python -m mlx_lm server --model mlx-community/Qwen2.5-1.5B-Instruct-4bit --adapter-path data/fly-language/best --host 127.0.0.1 --port 8081",
    "language:status": "node -e \"console.log(require('./data/fly-language/status.json'))\""
  },
  "engines": {
    "node": ">=22"
  }
}
